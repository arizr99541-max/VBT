-- =============================================
-- FIND ATTACK REMOTE
-- =============================================
local function findRemote()
    print("🔍 Scanning for attack remote...")
    
    -- Check common paths first
    local possiblePaths = {
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and 
ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Attack"),

ReplicatedStorage:FindFirstChild("Systems") and 
ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Combat") and ReplicatedStorage.Systems.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Combat") and ReplicatedStorage.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Game") and ReplicatedStorage.Game:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Remote") and ReplicatedStorage.Remote:FindFirstChild("Attack"),
    }
    
    for _, remote in ipairs(possiblePaths) do
        if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            print("✅ Found remote:", remote:GetFullName())
            return remote
        end
    end
    
    -- Deep scan as fallback
    local function deepScan(folder)
        for _, child in folder:GetChildren() do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                if child.Name:lower():find("attack") or child.Name:lower():find("combat") or child.Name:lower():find("damage") or child.Name:lower():find("hit") then
                    print("✅ Found remote via deep scan:", child:GetFullName())
                    return child
                end
            end
            if child:IsA("Folder") or child:IsA("Model") then
                local found = deepScan(child)
                if found then return found end
            end
        end
        return nil
    end
    
    local found = deepScan(ReplicatedStorage)
    if found then return found end
    
    error("❌ Could not find attack remote! Try updating the paths.")
    return nil
end

local Remote = findRemote()
local isRemoteEvent = Remote and Remote:IsA("RemoteEvent")

if not Remote then
    warn("❌ No attack remote found! Script will not work.")
    return
end

-- =============================================
-- ENTITY MANAGER (Caches targets for performance)
-- =============================================
local EntityManager = {
    cache = {},
    lastScan = 0,
    
    refresh = function(self)
        local newCache = {}
        
        -- Scan players
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local char = player.Character
                if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                    table.insert(newCache, {
                        character = char,
                        hrp = char.HumanoidRootPart,
                        humanoid = char.Humanoid,
                        type = "player",
                        player = player
                    })
                end
            end
        end
        
        -- Scan NPCs/Entities
        for _, child in Workspace:GetChildren() do
            if child:IsA("Model") and child ~= LocalPlayer.Character then
                local hrp = child:FindFirstChild("HumanoidRootPart")
                local hum = child:FindFirstChild("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    table.insert(newCache, {
                        character = child,
                        hrp = hrp,
                        humanoid = hum,
                        type = "npc"
                    })
                end
            end
        end
        
        self.cache = newCache
        self.lastScan = tick()
    end,
    
    getNearest = function(self, origin, maxDist)
        local best = nil
        local bestDist = maxDist * maxDist
        
        for _, target in ipairs(self.cache) do
            if target.hrp and target.hrp.Position then
                local dx = target.hrp.Position.X - origin.X
                local dy = target.hrp.Position.Y - origin.Y
                local dz = target.hrp.Position.Z - origin.Z
                local distSq = dx*dx + dy*dy + dz*dz
                
                if distSq < bestDist then
                    bestDist = distSq
                    best = target
                end
            end
        end
        
        return best
    end
}

