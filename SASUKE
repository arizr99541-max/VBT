-- =============================================
-- KILL AURA LOGIC
-- =============================================
local isEnabled = false
local renderConnection = nil
local lastAttackTime = 0
local attackCounter = 0
local rateLimitHit = false
local rateLimitRecoveryTime = 0

local function sendAttack(target)
    if not target or not target.character then return false end
    
    -- Rate limit check
    if rateLimitHit then
        if tick() - rateLimitRecoveryTime < 3 then
            return false
        else
            rateLimitHit = false
            print("🔄 Rate limit recovered, resuming attacks")
        end
    end
    
    -- Attack speed check
    local now = tick()
    local timeBetweenAttacks = 1 / CONFIG.MaxAttacksPerSecond
    if now - lastAttackTime < timeBetweenAttacks then
        return false
    end
    
    local success = false
    
    -- Try multiple attack formats
    local attempts = {
        function() 
            if isRemoteEvent then 
                Remote:FireServer(target.character, 1) 
            else 
                Remote:InvokeServer(target.character, 1) 
            end 
            return true 
        end,
        function() 
            if isRemoteEvent then 
                Remote:FireServer(target.character, target.humanoid, 1) 
            else 
                Remote:InvokeServer(target.character, target.humanoid, 1) 
            end 
            return true 
        end,
        function() 
            if isRemoteEvent then 
                Remote:FireServer(target.hrp, 1) 
            else 
                Remote:InvokeServer(target.hrp, 1) 
            end 
            return true 
        end,
        function() 
            if isRemoteEvent then 
                Remote:FireServer(target.character, 10) 
            else 
                Remote:InvokeServer(target.character, 10) 
            end 
            return true 
        end,
        function() 
            if isRemoteEvent then 
                Remote:FireServer(target.character) 
            else 
                Remote:InvokeServer(target.character) 
            end 
            return true 
        end
    }
    
    for _, attempt in ipairs(attempts) do
        local result, err = pcall(attempt)
        if result then
            success = true
            lastAttackTime = now
            attackCounter = attackCounter + 1
            break
        else
            if err and string.find(err:lower(), "rate") then
                rateLimitHit = true
                rateLimitRecoveryTime = now
                print("⚠️ Rate limit hit! Pausing for 3 seconds...")
                break
            end
        end
    end
    
    return success
end

local function attackLoop()
    if not isEnabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    -- Refresh target cache periodically
    if tick() - EntityManager.lastScan > CONFIG.ScanInterval then
        EntityManager:refresh()
    end
    
    -- Get nearest target
    local target = EntityManager:getNearest(hrp.Position, CONFIG.Range)
    if not target then return end
    
    -- Burst attacks
    for i = 1, CONFIG.BurstSize do
        if sendAttack(target) then
            if i < CONFIG.BurstSize then task.wait(0.03) end
        else
            break
        end
    end
end

-- =============================================
-- TOGGLE FUNCTION
-- =============================================
local function toggle()
    isEnabled = not isEnabled
    
    if isEnabled then
        if not renderConnection then
            renderConnection = RunService.Heartbeat:Connect(attackLoop)
        end
        EntityManager:refresh()
        attackCounter = 0
        rateLimitHit = false
        notify("✅ Kill Aura ENABLED (Press 🔥VBT_AURA to disable)")
        print("🔴 Kill Aura DISABLED - Press 🔥VBT_AURA to enable")
    else
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end
        notify("❌ Kill Aura DISABLED")
        print("🔵 Kill Aura DISABLED - Press O to enable")
    end
    
    -- Update GUI button if exists
    if _G.VOXEL_BUTTON then
        _G.VOXEL_BUTTON.Text = isEnabled and "🔥VBT_AURA " or "OFF VBT_AURA "
        _G.VOXEL_BUTTON.BackgroundColor3 = isEnabled and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(60, 60, 80)
    end
end

